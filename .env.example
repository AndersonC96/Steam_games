# Steam Library Explorer - Configuration Template
# Renomeie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA versione o arquivo .env real no controle de versão (Git).

# Sua chave privada da Steam Web API.
# Obtenha uma em: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Nome de usuário opcional para busca automática no carregamento inicial.
STEAM_USERNAME=
